# ===================================================
# SMART ATTENDANCE SYSTEM - BACKEND CONFIGURATION
# ===================================================

# Cloud MySQL Database Credentials
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_NAME=smart_attendance
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL_DISABLED=false

# Computer Vision & Recognition Settings
FACE_RECOGNITION_THRESHOLD=65.0
MIN_DATASET_IMAGES=25
CAMERA_INDEX=0

# Attendance Policy
ATTENDANCE_CUTOFF_TIME=09:30:00

# CORS & Server Settings
FRONTEND_URL=https://lens.sakra-vision.online
HOST=0.0.0.0
PORT=8000

# Resend Transactional Email Notifications
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Sakra-Lens <noreply@yourdomain.com>
